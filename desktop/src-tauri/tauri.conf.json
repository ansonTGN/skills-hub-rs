{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skills Hub Rust",
  "version": "0.2.0-alpha.1",
  "identifier": "com.ansontgn.skillshubrs",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Skills Hub Rust",
        "width": 1320,
        "height": 860,
        "minWidth": 940,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
